# Optional LLM for Turing Tester (scripts/llm_client.py): any OpenAI-compatible chat endpoint.
# With it, SFT tags the judge's critiques and writes training sentences aimed at the weaknesses;
# without it, the bundled sentence pool is used. Copy this file to .env (never committed) or export
# the variables. Examples: http://localhost:11434/v1 (Ollama), http://localhost:1234/v1 (LM Studio).
TURING_TESTER_LLM_BASE_URL=
TURING_TESTER_LLM_MODEL=
TURING_TESTER_LLM_API_KEY=
TURING_TESTER_LLM_TEMPERATURE=0.7
TURING_TESTER_LLM_MAX_TOKENS=1024
TURING_TESTER_LLM_TIMEOUT_SECONDS=300
