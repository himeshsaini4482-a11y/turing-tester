# Standalone Qwen 3.5 9B endpoint for direct general-purpose prompts.
# Copy this file to .env and obtain the bearer token from the deployment admin.
# Never commit .env or the real token.
VOICEGYM_QWEN_BASE_URL=https://api.uaitesting.com/general-llm/v1
VOICEGYM_QWEN_API_KEY=
VOICEGYM_QWEN_MODEL=qwen/qwen3.5-9b
VOICEGYM_QWEN_TIMEOUT_SECONDS=300
VOICEGYM_QWEN_TEMPERATURE=0.7
VOICEGYM_QWEN_MAX_TOKENS=1024
