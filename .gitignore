.venv-*/
__pycache__/
*.pyc

# downloaded on the VM
/data/
/pretrained/
/third_party/

# run outputs: keep the small result files, ignore audio and raw logs
runs/*/*
!runs/*/summary.json
!runs/*/metrics_summary.json
!runs/*/generation_config.json
!runs/*/btrm_summary.json
# job log/exit code from scripts/gpu_run.sh
/runs/job.*
/runs/*.log
scripts/gpu/state.env
