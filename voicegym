#!/bin/sh
# VoiceGym launcher (Linux, macOS, Git Bash on Windows).
#
#   ./voicegym doctor | setup | benchmark | sft | dpo   (./voicegym --help)
#
# Installs a pinned uv into .voicegym/bin the first time, then runs the CLI (voicegym_cli/) with a
# uv-managed Python 3.12. Nothing is installed outside the repo except uv's model/Hugging Face caches.
set -e
ROOT=$(cd "$(dirname "$0")" && pwd)
UV_VERSION=0.12.16
VG_HOME="$ROOT/.voicegym"
UV="$VG_HOME/bin/uv"
WINDOWS=0
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) WINDOWS=1; UV="$VG_HOME/bin/uv.exe" ;; esac

if [ ! -x "$UV" ]; then
  echo "voicegym: installing uv $UV_VERSION into .voicegym/bin (one time)" >&2
  mkdir -p "$VG_HOME/bin"
  if [ "$WINDOWS" = 1 ]; then
    powershell -NoProfile -ExecutionPolicy Bypass -Command \
      "\$env:UV_INSTALL_DIR='$(cygpath -w "$VG_HOME/bin")'; \$env:UV_NO_MODIFY_PATH='1'; irm https://astral.sh/uv/$UV_VERSION/install.ps1 | iex"
  elif command -v curl >/dev/null 2>&1; then
    curl -LsSf "https://astral.sh/uv/$UV_VERSION/install.sh" | env UV_INSTALL_DIR="$VG_HOME/bin" UV_NO_MODIFY_PATH=1 sh
  else
    wget -qO- "https://astral.sh/uv/$UV_VERSION/install.sh" | env UV_INSTALL_DIR="$VG_HOME/bin" UV_NO_MODIFY_PATH=1 sh
  fi
fi

export UV_PYTHON_INSTALL_DIR="$VG_HOME/python"
export UV_CACHE_DIR="$VG_HOME/cache/uv"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
export VOICEGYM_UV="$UV"
exec "$UV" run --quiet --no-project --python 3.12 --python-preference only-managed \
  --with pyyaml==6.0.2 python -m voicegym_cli "$@"
